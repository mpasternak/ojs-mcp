# Wykluczone z paczki `.mcpb`. Runtime `uv` rozwiązuje zależności z dołączonego
# pyproject.toml, więc wirtualne środowisko NIE może być wysyłane.
.git/
.github/
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
.eggs/
tests/
tools/
docs/
site/
.superpowers/
.pre-commit-config.yaml
*.mcpb
# Poświadczenia lokalne — nigdy do paczki (recenzja: W8 załatało
# `.gitignore`, ale nie tę listę osobną).
.env*
